{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": false,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/index.css",
    "baseColor": "stone",
    "cssVariables": true,
    "prefix": ""
  },
  "projectTheme": {
    "source": "src/theme/tokens.ts",
    "cssVariables": "src/theme/cssVariables.ts",
    "stylesheet": "src/index.css",
    "note": "Figma Sofia tokens in cssVariables.ts override shadcn baseColor defaults. Never use stock stone/zinc palette values in components."
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide"
}
